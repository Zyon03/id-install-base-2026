# Neon Postgres — pooled connection, used by the app at runtime
DATABASE_URL="postgresql://<user>:<password>@<pooler-host>/neondb?sslmode=require&pgbouncer=true"

# Neon Postgres — direct (unpooled) connection, used by `prisma migrate`
DIRECT_URL="postgresql://<user>:<password>@<direct-host>/neondb?sslmode=require"

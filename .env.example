# Neon Postgres — pooled connection, used by the app at runtime
DATABASE_URL="postgresql://<user>:<password>@<pooler-host>/neondb?sslmode=verify-full&pgbouncer=true"

# Neon Postgres — direct (unpooled) connection, used by `prisma migrate`
DIRECT_URL="postgresql://<user>:<password>@<direct-host>/neondb?sslmode=verify-full"

# Signs the /installs session cookie (HMAC-SHA256). Never the password
# itself — generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
AUTH_COOKIE_SECRET="<random-hex-string>"
